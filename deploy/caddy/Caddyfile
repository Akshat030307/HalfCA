# Inside the web container: serve the static export and proxy /api to FastAPI.
# HTTPS is handled upstream by the VPS's shared Caddy, so this listens on plain :80.
{
	admin 127.0.0.1:2019
	auto_https off
}

:80 {
	# Compress everything except the copilot's event stream, which must flush per event.
	@compressible not path /api/copilot
	encode @compressible zstd gzip

	handle /api/* {
		request_body {
			max_size 50MB
		}
		# text/event-stream (copilot) is flushed immediately by reverse_proxy.
		reverse_proxy api:8000
	}

	handle {
		@root path /
		redir @root /upload/ 302

		@static path /_next/static/*
		header @static Cache-Control "public, max-age=31536000, immutable"

		root * /srv
		try_files {path} {path}/index.html {path}.html
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		root * /srv
		file_server
	}
}
